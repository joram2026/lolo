rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is the Admin
    function isAdmin() {
      return request.auth != null && 
             (
               (request.auth.token != null && request.auth.token.email != null && request.auth.token.email.lower() == 'love@gmail.com') ||
               (request.auth.token != null && request.auth.token.email != null && request.auth.token.email.lower() == 'joram4036@gmail.com')
             );
    }

    // Helper function to check if the user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Users Collection rules
    match /users/{userId} {
      allow read, list: if true;
      allow create, update, delete: if isAuth();
    }

    // Transactions Collection rules
    match /transactions/{transactionId} {
      allow read, list: if isAuth();
      allow create, update, delete: if isAuth();
    }

    // Referral Codes mapping rules
    match /referralCodes/{code} {
      allow read, list: if isAuth();
      allow create, update, delete: if isAuth();
    }

    // Crypto Networks configuration rules
    match /crypto_networks/{networkId} {
      allow read, list: if true;
      allow create, update, delete: if isAuth();
    }

    // P2P Merchants configuration rules
    match /p2p_merchants/{merchantId} {
      allow read, list: if true;
      allow create, update, delete: if isAuth();
    }

    // Crypto Prices configuration rules
    match /crypto_prices/{symbol} {
      allow read, list: if true;
      allow write, create, update, delete: if true;
    }

    // Investments configuration rules
    match /investments/{investmentId} {
      allow read, list: if isAuth();
      allow create, update, delete: if isAuth();
    }

    // Bot Templates rules
    match /bot_templates/{templateId} {
      allow read, list: if true;
      allow create, update, delete: if isAuth();
    }

    // User Bots rules
    match /user_bots/{botId} {
      allow read, list: if isAuth();
      allow create, update, delete: if isAuth();
    }

    // Settings configuration rules
    match /settings/{settingId} {
      allow read, list: if true;
      allow create, update, delete: if isAuth();
    }
  }
}
